

# ==============================
# Database
# ==============================
DATABASE_URL="postgresql://username:password@localhost:5432/splitz"

# ==============================
# JWT
# ==============================
JWT_SECRET="replace_with_a_long_random_access_token_secret"

JWT_REFRESH_SECRET="replace_with_a_different_long_random_refresh_secret"

# ==============================
# Server
# ==============================
PORT=5000

NODE_ENV=development

# Comma-separated exact browser origins, for example http://localhost:5173.
# CLIENT_URL is the primary frontend origin; CLIENT_ORIGINS adds more.
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=
COOKIE_SAME_SITE=strict

# Number of trusted reverse-proxy hops. Leave unset unless the API is behind a
# known proxy/load balancer, then set the exact hop count (usually 1).
TRUST_PROXY=

# Optional Gmail OAuth2 delivery. Leave all four blank to disable email.
EMAIL_USER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=

# Required only for integration tests; must identify an isolated test database.
TEST_DATABASE_URL=